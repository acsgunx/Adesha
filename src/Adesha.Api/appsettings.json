{
  "Adesha": {
    "TradingMode": "Disabled",
    "Jwt": {
      "Issuer": "adesha",
      "Audience": "adesha-web",
      "AccessTokenLifetimeMinutes": 10,
      "RefreshTokenLifetimeDays": 7
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
